#include <iostream>
#include <string>
using namespace std;

int main() {
    string text = "Do you like programming?\nI love programming!\nBut sometimes I lose my head from love.\n:)";
    // 1. вывод всех знаков препинания
    cout << "1. Знаки препинания в тексте: ";
    for (int i = 0; i < text.length(); i++) {
        char c = text[i];
        if (c == '?' || c == '!' || c == '.' || c == ':' || c == ')') {
            cout << c << " ";
        }
    }
    cout << endl;
    // 2. вывод последнего слова текста
    string lastWord = "";
    // идем с конца строки назад
    for (int i = text.length() - 1; i >= 0; i--) {
        // проверка буква ли это 
        if ((text[i] >= 'a' && text[i] <= 'z') || (text[i] >= 'A' && text[i] <= 'Z')) {
            // прибавляем букву В начало строки, чтобы слово не перевернулось
            lastWord = text[i] + lastWord;
            if (text[i - 1] == ' ') {
                break; 
            }
        }
    }
    cout << "2. Последнее слово: " << lastWord << endl;
    return 0;
}
