#include <iostream>
#include <string>
using namespace std;

int main() {
    // берем первую строку из задания
    string s = "Do you like programming?";
    string word = "";     // текущее слово, которое мы сейчас читаем
    string maxWord = ""; 
    for (int i = 0; i < s.length(); i++) {
        if (s[i] != ' ' && s[i] != '?' && s[i] != '.') {
            word = word + s[i];
        } 
        else {
            // если встретили пробел или конец — проверяем длину слова
            if (word.length() > maxWord.length()) {
                maxWord = word;
            }
            word = ""; // сбрасываем, чтобы начать собирать новое слово
        }
    }
    if (word.length() > maxWord.length()) {
        maxWord = word;
    }
    cout << "Самое длинное слово: " << maxWord << endl;
    return 0;
}
