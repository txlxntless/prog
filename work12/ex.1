#include <iostream>
using namespace std;

// вычисление определителя матрицы 3x3
double calculateDeterminant(double a[3][3]) {
    return a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1]) -
           a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0]) +
           a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]);
}

int main() {
    // коэффициенты системы (матрица A)
    double A[3][3] = {
        {2, 4, 1},
        {5, 2, 1},
        {2, 3, 4}
    };
    // свободные члены (столбец B)
    double B[3] = {36, 47, 37};
    // находим главный определитель (D)
    double D = calculateDeterminant(A);

    if (D == 0) {
        cout << "Система не имеет однозначного решения (определитель равен 0)." << endl;
        return 0;
    }
    // находим вспомогательные определители (Dx0, Dx1, Dx2)
    double tempMatrix[3][3];
    double Dx[3];

    for (int i = 0; i < 3; i++) {
        for (int row = 0; row < 3; row++) {
            for (int col = 0; col < 3; col++) {
                tempMatrix[row][col] = A[row][col];
            }
        }
        // заменяем i-й столбец в временной матрице на столбец B
        for (int row = 0; row < 3; row++) {
            tempMatrix[row][i] = B[row];
        }
        Dx[i] = calculateDeterminant(tempMatrix);
    }
    // вычисляем корни
    double x0 = Dx[0] / D;
    double x1 = Dx[1] / D;
    double x2 = Dx[2] / D;
    // выводы результатов
    cout << "Решение СЛАУ:" << endl;
    cout << "x0 = " << x0 << endl;
    cout << "x1 = " << x1 << endl;
    cout << "x2 = " << x2 << endl;
    // проверка
    cout << "\nПроверка:" << endl;
    cout << "2*" << x0 << " + 4*" << x1 << " + 1*" << x2 << " = " << (2 * x0 + 4 * x1 + x2) << " (должно быть 36)" << endl;
    cout << "5*" << x0 << " + 2*" << x1 << " + 1*" << x2 << " = " << (5 * x0 + 2 * x1 + x2) << " (должно быть 47)" << endl;
    cout << "2*" << x0 << " + 3*" << x1 << " + 4*" << x2 << " = " << (2 * x0 + 3 * x1 + 4 * x2) << " (должно быть 37)" << endl;
    return 0;
}
