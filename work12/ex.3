#include <iostream>
#include <iomanip> // для красивого вывода
using namespace std;

int main() {
    // исходная матрица
    double A[3][3] = {
        {2, 1, 0},
        {2, 4, 1},
        {2, 5, 8}
    };
    // считаем определитель
    double det = A[0][0] * (A[1][1] * A[2][2] - A[1][2] * A[2][1]) -
                 A[0][1] * (A[1][0] * A[2][2] - A[1][2] * A[2][0]) +
                 A[0][2] * (A[1][0] * A[2][1] - A[1][1] * A[2][0]);
    if (det == 0) {
        cout << "Обратной матрицы не существует (det = 0)" << endl;
        return 0;
    }
    // создаем матрицу алгебраических дополнений (C)
    // C[i][j] - это определитель минора со знаком (-1)^(i+j)
    double adj[3][3];
    adj[0][0] =  (A[1][1] * A[2][2] - A[1][2] * A[2][1]);
    adj[0][1] = -(A[1][0] * A[2][2] - A[1][2] * A[2][0]);
    adj[0][2] =  (A[1][0] * A[2][1] - A[1][1] * A[2][0]);
    adj[1][0] = -(A[0][1] * A[2][2] - A[0][2] * A[2][1]);
    adj[1][1] =  (A[0][0] * A[2][2] - A[0][2] * A[2][0]);
    adj[1][2] = -(A[0][0] * A[2][1] - A[0][1] * A[2][0]);
    adj[2][0] =  (A[0][1] * A[1][2] - A[0][2] * A[1][1]);
    adj[2][1] = -(A[0][0] * A[1][2] - A[0][2] * A[1][0]);
    adj[2][2] =  (A[0][0] * A[1][1] - A[0][1] * A[1][0]);
    // вычисляем финальную матрицу (транспонируем и делим на det)
    double inv[3][3];
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            inv[i][j] = adj[j][i] / det; // j и i поменяны местами при транспонировании
        }
    }
    // вывод результата
    cout << "Обратная матрица (A^-1):" << endl;
    cout << fixed << setprecision(2); // ограничим вывод 2 знаками после запятой
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cout << setw(10) << inv[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
