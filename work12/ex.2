#include <iostream>
using namespace std;

int main() {
    // инициализируем матрицу
    int matrix[3][3] = {
        {2, 1, 0},
        {2, 4, 1},
        {2, 5, 8}
    };
    // вычисляем определитель по формуле:
    int det = matrix[0][0] * matrix[1][1] * matrix[2][2] +
              matrix[0][1] * matrix[1][2] * matrix[2][0] +
              matrix[0][2] * matrix[1][0] * matrix[2][1] -
              matrix[0][2] * matrix[1][1] * matrix[2][0] -
              matrix[0][0] * matrix[1][2] * matrix[2][1] -
              matrix[0][1] * matrix[1][0] * matrix[2][2];
    // вывод матрицы для наглядности
    cout << "Матрица:" << endl;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cout << matrix[i][j] << "\t";
        }
        cout << endl;
    }
    cout << "\nОпределитель матрицы равен: " << det << endl;
    return 0;
}
